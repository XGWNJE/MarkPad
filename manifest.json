{
  "manifest_version": 3,
  "name": "MarkPad",
  "version": "0.2.0",
  "description": "面向触控操作的新标签页书签面板",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "favicon",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.iconfont.cn/*",
    "https://api.iconify.design/*",
    "https://api.svgapi.com/*",
    "https://cdn.svgapi.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
